# CrisisWatch Lagos — Environment Variables
# Copy this file to .env and fill in your values
# Never commit .env to GitHub

# ── Flask ──
SECRET_KEY=your-secret-key-here-make-it-long-and-random
JWT_SECRET_KEY=another-secret-key-here

# ── Email (Gmail) ──
MAIL_USERNAME=youremail@gmail.com
MAIL_PASSWORD=abcdefghijklmnop    # 16-char Gmail App Password, no spaces

# ── Reddit API (free — https://www.reddit.com/prefs/apps) ──
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=CrisisWatchLagos/1.0 by YourRedditUsername

# ── Telegram API (free — https://my.telegram.org) ──
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=abcdefghijklmnop1234567890abcdef
TELEGRAM_PHONE=+2348012345678

# ── Database (leave blank for SQLite during development) ──
DATABASE_URL=
